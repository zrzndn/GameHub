<UserControl x:Class="WindowsITToolkit.GameLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WindowsITToolkit"
             Loaded="GameLibraryView_Loaded"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="GameArtworkStyle" TargetType="{x:Type FrameworkElement}">
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
        <DataTemplate x:Key="GameCardTemplate" DataType="{x:Type local:GameCatalogItem}">
            <Border Style="{StaticResource HubGameCardStyle}"
                    Loaded="GameCard_Loaded">
                <StackPanel>
                    <Grid Height="164" ClipToBounds="True">
                        <Border x:Name="ArtworkFallback"
                                CornerRadius="10">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Background" Value="{StaticResource HubArtworkBlueBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GameId}" Value="snake">
                                            <Setter Property="Background" Value="{StaticResource SnakeArtworkBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding GameId}" Value="tic-tac-toe">
                                            <Setter Property="Background" Value="{StaticResource TicTacToeArtworkBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding GameId}" Value="minesweeper">
                                            <Setter Property="Background" Value="{StaticResource MinesweeperArtworkBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding GameId}" Value="2048">
                                            <Setter Property="Background" Value="{StaticResource TwentyFortyEightArtworkBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding GameId}" Value="pong">
                                            <Setter Property="Background" Value="{StaticResource PongArtworkBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding GameId}" Value="memory-match">
                                            <Setter Property="Background" Value="{StaticResource MemoryArtworkBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Ellipse Width="180"
                                         Height="150"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Top"
                                         Margin="0,-64,-36,0"
                                         Fill="{StaticResource HubArtworkPinkBrush}"
                                         Opacity="0.8"/>
                                <Ellipse Width="110"
                                         Height="98"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Bottom"
                                         Margin="-35,0,0,-45"
                                         Fill="{StaticResource HubArtworkTealBrush}"
                                         Opacity="0.8"/>
                                <TextBlock Text="{Binding Category, StringFormat={}{0} GAME}"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Top"
                                           Margin="12"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource HubCardBrush}"/>

                                <Canvas x:Name="SnakeArt"
                                        Style="{StaticResource GameArtworkStyle}"
                                        Width="230"
                                        Height="116"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    <Border Canvas.Left="28" Canvas.Top="31" Width="42" Height="29" CornerRadius="10" Background="#A7F3D0"/>
                                    <Border Canvas.Left="63" Canvas.Top="31" Width="42" Height="29" CornerRadius="10" Background="#6EE7B7"/>
                                    <Border Canvas.Left="98" Canvas.Top="31" Width="42" Height="29" CornerRadius="10" Background="#34D399"/>
                                    <Border Canvas.Left="98" Canvas.Top="55" Width="42" Height="29" CornerRadius="10" Background="#10B981"/>
                                    <Border Canvas.Left="133" Canvas.Top="55" Width="42" Height="29" CornerRadius="10" Background="#059669"/>
                                    <Ellipse Canvas.Left="177" Canvas.Top="27" Width="19" Height="19" Fill="#FB7185"/>
                                    <Ellipse Canvas.Left="186" Canvas.Top="32" Width="4" Height="4" Fill="White"/>
                                    <TextBlock Canvas.Left="25" Canvas.Top="87" Text="SNAKE" FontSize="10" FontWeight="Bold" Foreground="White" Opacity="0.88"/>
                                </Canvas>

                                <Viewbox x:Name="TicTacToeArt"
                                         Style="{StaticResource GameArtworkStyle}"
                                         Width="146"
                                         Height="124">
                                    <UniformGrid Width="150" Height="126" Rows="3" Columns="3">
                                        <Border Margin="3" CornerRadius="8" Background="#FFFFFF" Opacity="0.92"><TextBlock Text="X" FontSize="31" FontWeight="ExtraBold" Foreground="#6D28D9" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <Border Margin="3" CornerRadius="8" Background="#FFFFFF" Opacity="0.78"><TextBlock Text="O" FontSize="31" FontWeight="ExtraBold" Foreground="#0F766E" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <Border Margin="3" CornerRadius="8" Background="#FFFFFF" Opacity="0.62"/>
                                        <Border Margin="3" CornerRadius="8" Background="#FFFFFF" Opacity="0.78"><TextBlock Text="O" FontSize="31" FontWeight="ExtraBold" Foreground="#0F766E" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <Border Margin="3" CornerRadius="8" Background="#FFFFFF" Opacity="0.92"><TextBlock Text="X" FontSize="31" FontWeight="ExtraBold" Foreground="#6D28D9" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <Border Margin="3" CornerRadius="8" Background="#FFFFFF" Opacity="0.62"/>
                                        <Border Margin="3" CornerRadius="8" Background="#FFFFFF" Opacity="0.62"/>
                                        <Border Margin="3" CornerRadius="8" Background="#FFFFFF" Opacity="0.62"/>
                                        <Border Margin="3" CornerRadius="8" Background="#FFFFFF" Opacity="0.92"><TextBlock Text="X" FontSize="31" FontWeight="ExtraBold" Foreground="#6D28D9" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                    </UniformGrid>
                                </Viewbox>

                                <Viewbox x:Name="MinesweeperArt"
                                         Style="{StaticResource GameArtworkStyle}"
                                         Width="162"
                                         Height="122">
                                    <UniformGrid Width="168" Height="126" Rows="3" Columns="4">
                                        <Border Margin="3" CornerRadius="6" Background="#FFFBEB"><TextBlock Text="1" FontSize="22" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <Border Margin="3" CornerRadius="6" Background="#F8FAFC"><TextBlock Text="2" FontSize="22" FontWeight="Bold" Foreground="#16A34A" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <Border Margin="3" CornerRadius="6" Background="#FFFBEB"><TextBlock Text="✹" FontSize="22" FontWeight="Bold" Foreground="#DC2626" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <Border Margin="3" CornerRadius="6" Background="#F8FAFC"/>
                                        <Border Margin="3" CornerRadius="6" Background="#F8FAFC"><TextBlock Text="1" FontSize="22" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <Border Margin="3" CornerRadius="6" Background="#FFFBEB"><TextBlock Text="2" FontSize="22" FontWeight="Bold" Foreground="#16A34A" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <Border Margin="3" CornerRadius="6" Background="#F8FAFC"><TextBlock Text="1" FontSize="22" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <Border Margin="3" CornerRadius="6" Background="#FFFBEB"/>
                                        <Border Margin="3" CornerRadius="6" Background="#FFFBEB"/>
                                        <Border Margin="3" CornerRadius="6" Background="#F8FAFC"><TextBlock Text="1" FontSize="22" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <Border Margin="3" CornerRadius="6" Background="#FFFBEB"><TextBlock Text="⚑" FontSize="19" FontWeight="Bold" Foreground="#DC2626" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <Border Margin="3" CornerRadius="6" Background="#F8FAFC"/>
                                    </UniformGrid>
                                </Viewbox>

                                <Viewbox x:Name="TwentyFortyEightArt"
                                         Style="{StaticResource GameArtworkStyle}"
                                         Width="150"
                                         Height="124">
                                    <UniformGrid Width="150" Height="126" Rows="2" Columns="2">
                                        <Border Margin="4" CornerRadius="11" Background="#DBEAFE"><TextBlock Text="2" FontSize="37" FontWeight="ExtraBold" Foreground="#1D4ED8" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <Border Margin="4" CornerRadius="11" Background="#BFDBFE"><TextBlock Text="4" FontSize="37" FontWeight="ExtraBold" Foreground="#1D4ED8" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <Border Margin="4" CornerRadius="11" Background="#60A5FA"><TextBlock Text="8" FontSize="37" FontWeight="ExtraBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <Border Margin="4" CornerRadius="11" Background="#2563EB"><TextBlock Text="2048" FontSize="25" FontWeight="ExtraBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                    </UniformGrid>
                                </Viewbox>

                                <Canvas x:Name="PongArt"
                                        Style="{StaticResource GameArtworkStyle}"
                                        Width="232"
                                        Height="116"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    <Border Canvas.Left="16" Canvas.Top="13" Width="200" Height="90" CornerRadius="12" Background="#172033" BorderBrush="#94A3B8" BorderThickness="1"/>
                                    <Line Canvas.Left="115" Canvas.Top="18" X1="0" Y1="0" X2="0" Y2="80" Stroke="#64748B" StrokeThickness="2" StrokeDashArray="3,3"/>
                                    <Border Canvas.Left="33" Canvas.Top="42" Width="8" Height="34" CornerRadius="4" Background="#60A5FA"/>
                                    <Border Canvas.Left="191" Canvas.Top="31" Width="8" Height="34" CornerRadius="4" Background="#5EEAD4"/>
                                    <Ellipse Canvas.Left="125" Canvas.Top="49" Width="14" Height="14" Fill="#FFFFFF"/>
                                    <TextBlock Canvas.Left="87" Canvas.Top="18" Text="PONG" FontSize="10" FontWeight="Bold" Foreground="#CBD5E1"/>
                                </Canvas>

                                <Canvas x:Name="MemoryMatchArt"
                                        Style="{StaticResource GameArtworkStyle}"
                                        Width="220"
                                        Height="122"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    <Border Canvas.Left="37" Canvas.Top="20" Width="67" Height="88" CornerRadius="11" Background="#FFFFFF" Opacity="0.96" RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform><RotateTransform Angle="-13"/></Border.RenderTransform>
                                        <TextBlock Text="★" FontSize="34" FontWeight="Bold" Foreground="#BE185D" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Canvas.Left="80" Canvas.Top="13" Width="67" Height="88" CornerRadius="11" Background="#FFFFFF" Opacity="0.96">
                                        <TextBlock Text="◆" FontSize="34" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Canvas.Left="123" Canvas.Top="20" Width="67" Height="88" CornerRadius="11" Background="#FFFFFF" Opacity="0.96" RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform><RotateTransform Angle="13"/></Border.RenderTransform>
                                        <TextBlock Text="★" FontSize="34" FontWeight="Bold" Foreground="#BE185D" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Canvas>
                            </Grid>
                        </Border>
                        <Image Source="{Binding ArtworkPath}"
                               Stretch="UniformToFill"
                               ImageFailed="ArtworkImage_ImageFailed"/>
                        <Border HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="10"
                                Padding="9,5"
                                CornerRadius="10"
                                Background="{StaticResource HubCardBrush}"
                                BorderBrush="{StaticResource HubBorderBrush}"
                                BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Availability}"
                                                     Value="{x:Static local:GameAvailability.Available}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="COMING SOON"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource HubComingSoonBrush}"/>
                        </Border>
                    </Grid>

                    <TextBlock Text="{Binding DisplayName}"
                               Margin="2,15,2,5"
                               FontSize="19"
                               FontWeight="Bold"
                               Foreground="{StaticResource HubTextBrush}"/>
                    <TextBlock Text="{Binding Description}"
                               Margin="2,0,2,14"
                               MinHeight="40"
                               FontSize="12"
                               Foreground="{StaticResource HubMutedBrush}"
                               TextWrapping="Wrap"
                               LineHeight="18"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="PLAY"
                                Click="PlayButton_Click"
                                Height="39">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource HubButtonPrimaryStyle}">
                                    <Setter Property="IsEnabled" Value="False"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Availability}"
                                                     Value="{x:Static local:GameAvailability.Available}">
                                            <Setter Property="IsEnabled" Value="True"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Column="1"
                                Width="42"
                                Height="39"
                                Margin="8,0,0,0"
                                Padding="0"
                                Content="☆"
                                FontSize="18"
                                Style="{StaticResource HubButtonStyle}"
                                Click="FavoriteButton_Click"
                                ToolTip="Add to favorites"/>
                    </Grid>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding GameId}" Value="snake">
                    <Setter TargetName="SnakeArt" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding GameId}" Value="tic-tac-toe">
                    <Setter TargetName="TicTacToeArt" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding GameId}" Value="minesweeper">
                    <Setter TargetName="MinesweeperArt" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding GameId}" Value="2048">
                    <Setter TargetName="TwentyFortyEightArt" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding GameId}" Value="pong">
                    <Setter TargetName="PongArt" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding GameId}" Value="memory-match">
                    <Setter TargetName="MemoryMatchArt" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="0,4,0,22">
            <TextBlock Text="THE GAME LIBRARY"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="{StaticResource HubAccentBrush}"/>
            <Grid Margin="0,7,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Find your next game."
                               FontSize="32"
                               FontWeight="ExtraBold"
                               Foreground="{StaticResource HubTextBrush}"/>
                    <TextBlock Text="A growing collection of quick games, ready when you are."
                               Margin="0,5,0,0"
                               FontSize="13"
                               Foreground="{StaticResource HubMutedBrush}"/>
                </StackPanel>
                <Border Grid.Column="1"
                        Padding="15,10"
                        CornerRadius="10"
                        Background="{StaticResource HubCardBrush}"
                        BorderBrush="{StaticResource HubBorderBrush}"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="6"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource HubAccentBrush}"/>
                        <TextBlock Text="  GAMES"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource HubMutedBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <RadioButton x:Name="AllGamesFilter"
                                 Content="All games"
                                 Tag="All"
                                 GroupName="CategoryFilters"
                                 IsChecked="True"
                                 Style="{StaticResource CategoryFilterStyle}"/>
                    <RadioButton x:Name="ArcadeFilter"
                                 Content="Arcade"
                                 Tag="Arcade"
                                 GroupName="CategoryFilters"
                                 Style="{StaticResource CategoryFilterStyle}"/>
                    <RadioButton x:Name="PuzzleFilter"
                                 Content="Puzzle"
                                 Tag="Puzzle"
                                 GroupName="CategoryFilters"
                                 Style="{StaticResource CategoryFilterStyle}"/>
                    <RadioButton x:Name="StrategyFilter"
                                 Content="Strategy"
                                 Tag="Strategy"
                                 GroupName="CategoryFilters"
                                 Style="{StaticResource CategoryFilterStyle}"/>
                </StackPanel>
                <Grid Grid.Column="1"
                      Width="260"
                      Height="40"
                      VerticalAlignment="Center">
                    <TextBox x:Name="SearchTextBox"
                             Style="{StaticResource SearchBoxStyle}"
                             TextChanged="SearchTextBox_TextChanged"/>
                    <Grid Width="18"
                          Height="18"
                          Margin="13,0,0,0"
                          HorizontalAlignment="Left"
                          IsHitTestVisible="False">
                        <Ellipse Width="10"
                                 Height="10"
                                 Stroke="{StaticResource HubMutedBrush}"
                                 StrokeThickness="1.5"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Top"/>
                        <Line X1="8"
                              Y1="8"
                              X2="15"
                              Y2="15"
                              Stroke="{StaticResource HubMutedBrush}"
                              StrokeThickness="1.5"/>
                    </Grid>
                    <TextBlock Text="Search games"
                               Margin="38,0,0,0"
                               FontSize="13"
                               Foreground="{StaticResource HubMutedBrush}"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock x:Name="ResultsHeading"
                           Text="ALL GAMES"
                           Margin="0,0,0,14"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="{StaticResource HubMutedBrush}"/>
                <ItemsControl x:Name="GamesList"
                              ItemsSource="{Binding Games}"
                              ItemTemplate="{StaticResource GameCardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <Border x:Name="EmptyState"
                        Visibility="Collapsed"
                        Padding="28"
                        Margin="0,8,0,0"
                        CornerRadius="14"
                        Background="{StaticResource HubCardBrush}"
                        BorderBrush="{StaticResource HubBorderBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="No games found"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource HubTextBrush}"/>
                        <TextBlock Text="Try a different search or category."
                                   Margin="0,5,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource HubMutedBrush}"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="New games will appear here as they become available."
                           Margin="0,2,0,10"
                           FontSize="11"
                           Foreground="{StaticResource HubMutedBrush}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
