<UserControl x:Class="WindowsITToolkit.Games.Pong.PongGameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="PONG"
                           FontSize="26"
                           FontWeight="ExtraBold"
                           Foreground="{StaticResource HubTextBrush}"/>
                <TextBlock Text="W / ↑ MOVE UP   ·   S / ↓ MOVE DOWN   ·   SPACE PAUSE"
                           Margin="0,4,0,0"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource HubMutedBrush}"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" Margin="0,0,28,0">
                    <TextBlock Text="YOU"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{StaticResource HubMutedBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="PlayerScoreText"
                               Text="0"
                               FontSize="34"
                               FontWeight="ExtraBold"
                               Foreground="{StaticResource HubAccentBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text=":"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="{StaticResource HubMutedBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,28,0"/>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="COMPUTER"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{StaticResource HubMutedBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="OpponentScoreText"
                               Text="0"
                               FontSize="34"
                               FontWeight="ExtraBold"
                               Foreground="{StaticResource HubSecondaryAccentBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <TextBlock Text="DIFFICULTY"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="{StaticResource HubMutedBrush}"/>
                <ComboBox x:Name="DifficultyComboBox"
                          Width="110"
                          Height="36"
                          SelectedIndex="1"
                          Background="{StaticResource HubCardBrush}"
                          Foreground="{StaticResource HubTextBrush}"
                          BorderBrush="{StaticResource HubBorderBrush}"
                          SelectionChanged="DifficultyComboBox_SelectionChanged">
                    <ComboBoxItem Content="Easy"/>
                    <ComboBoxItem Content="Normal"/>
                    <ComboBoxItem Content="Hard"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                MinHeight="280"
                Padding="8"
                CornerRadius="16"
                Background="{StaticResource HubCardBrush}"
                BorderBrush="{StaticResource HubBorderBrush}"
                BorderThickness="1"
                Effect="{StaticResource HubCardShadow}">
            <Grid>
                <pong:PongArena x:Name="Arena"
                                xmlns:pong="clr-namespace:WindowsITToolkit.Games.Pong"
                                MinWidth="320"
                                MinHeight="260"
                                ClipToBounds="True"/>
                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,16,0,0"
                        Padding="14,8"
                        CornerRadius="12"
                        Background="#CC0F172A"
                        IsHitTestVisible="False">
                    <TextBlock x:Name="StatusText"
                               Text="Ready"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"
                               HorizontalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatisticsText"
                       Text="Matches 0  ·  Wins 0  ·  Losses 0  ·  Best rally 0"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="{StaticResource HubMutedBrush}"
                       TextWrapping="Wrap"/>
            <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                <Button x:Name="PauseButton"
                        Content="PAUSE"
                        Click="PauseButton_Click"
                        Height="40"
                        MinWidth="90"
                        Margin="0,0,8,0"
                        Style="{StaticResource HubButtonSecondaryStyle}"/>
                <Button Content="NEW MATCH"
                        Click="NewMatchButton_Click"
                        Height="40"
                        MinWidth="112"
                        Margin="0,0,8,0"
                        Style="{StaticResource HubButtonPrimaryStyle}"/>
                <Button Content="BACK TO LIBRARY"
                        Click="BackButton_Click"
                        Height="40"
                        MinWidth="145"
                        Style="{StaticResource HubButtonStyle}"/>
            </WrapPanel>
        </Grid>
    </Grid>
</UserControl>
