<UserControl x:Class="WindowsITToolkit.Games.Minesweeper.MinesweeperGameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="MINESWEEPER"
                           FontSize="26"
                           FontWeight="ExtraBold"
                           Foreground="{StaticResource HubTextBrush}"/>
                <TextBlock Text="CLEAR THE FIELD. FLAG EVERY MINE."
                           Margin="0,4,0,0"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource HubMutedBrush}"/>
            </StackPanel>
            <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                <Border Padding="12,7" Margin="0,0,8,0" CornerRadius="10" Background="{StaticResource HubCardBrush}" BorderBrush="{StaticResource HubBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="MINES" FontSize="9" FontWeight="Bold" Foreground="{StaticResource HubMutedBrush}"/>
                        <TextBlock x:Name="MineCountText" Text="10" FontSize="19" FontWeight="Bold" Foreground="{StaticResource HubAccentBrush}"/>
                    </StackPanel>
                </Border>
                <Border Padding="12,7" CornerRadius="10" Background="{StaticResource HubCardBrush}" BorderBrush="{StaticResource HubBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="TIME" FontSize="9" FontWeight="Bold" Foreground="{StaticResource HubMutedBrush}"/>
                        <TextBlock x:Name="ElapsedText" Text="00:00" FontSize="19" FontWeight="Bold" Foreground="{StaticResource HubSecondaryAccentBrush}"/>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <WrapPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="DIFFICULTY"
                           VerticalAlignment="Center"
                           Margin="0,0,10,8"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="{StaticResource HubMutedBrush}"/>
                <ComboBox x:Name="DifficultyComboBox"
                          Width="150"
                          Height="36"
                          SelectedIndex="0"
                          Margin="0,0,10,8"
                          Background="{StaticResource HubCardBrush}"
                          Foreground="{StaticResource HubTextBrush}"
                          BorderBrush="{StaticResource HubBorderBrush}"
                          SelectionChanged="DifficultyComboBox_SelectionChanged">
                    <ComboBoxItem Content="Beginner"/>
                    <ComboBoxItem Content="Intermediate"/>
                    <ComboBoxItem Content="Expert"/>
                </ComboBox>
                <Button Content="NEW GAME"
                        Click="NewGameButton_Click"
                        Height="36"
                        MinWidth="110"
                        Margin="0,0,10,8"
                        Style="{StaticResource HubButtonPrimaryStyle}"/>
                <TextBlock x:Name="BestTimeText"
                           Text="Best: --:--"
                           VerticalAlignment="Center"
                           Margin="0,0,10,8"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource HubMutedBrush}"/>
            </WrapPanel>

            <ScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Background="{StaticResource HubCardBrush}">
                <Border Padding="10"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        CornerRadius="12"
                        Background="{StaticResource HubCardBrush}"
                        BorderBrush="{StaticResource HubBorderBrush}"
                        BorderThickness="1">
                    <UniformGrid x:Name="BoardGrid"/>
                </Border>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText"
                           Text="Reveal a cell to begin."
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource HubAccentBrush}"/>
                <Button Grid.Column="1"
                        Content="BACK TO LIBRARY"
                        Click="BackButton_Click"
                        Height="38"
                        MinWidth="150"
                        Margin="8,0,0,0"
                        Style="{StaticResource HubButtonStyle}"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
