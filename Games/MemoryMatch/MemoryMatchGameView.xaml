<UserControl x:Class="WindowsITToolkit.Games.MemoryMatch.MemoryMatchGameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="MEMORY MATCH"
                           FontSize="26"
                           FontWeight="ExtraBold"
                           Foreground="{StaticResource HubTextBrush}"/>
                <TextBlock Text="FIND EVERY MATCHING PAIR"
                           Margin="0,4,0,0"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource HubMutedBrush}"/>
            </StackPanel>
            <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                <Border Padding="11,7" Margin="0,0,7,0" CornerRadius="10" Background="{StaticResource HubCardBrush}" BorderBrush="{StaticResource HubBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="MOVES" FontSize="9" FontWeight="Bold" Foreground="{StaticResource HubMutedBrush}"/>
                        <TextBlock x:Name="MovesText" Text="0" FontSize="18" FontWeight="Bold" Foreground="{StaticResource HubAccentBrush}"/>
                    </StackPanel>
                </Border>
                <Border Padding="11,7" Margin="0,0,7,0" CornerRadius="10" Background="{StaticResource HubCardBrush}" BorderBrush="{StaticResource HubBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="PAIRS" FontSize="9" FontWeight="Bold" Foreground="{StaticResource HubMutedBrush}"/>
                        <TextBlock x:Name="PairsText" Text="0 / 8" FontSize="18" FontWeight="Bold" Foreground="{StaticResource HubSecondaryAccentBrush}"/>
                    </StackPanel>
                </Border>
                <Border Padding="11,7" CornerRadius="10" Background="{StaticResource HubCardBrush}" BorderBrush="{StaticResource HubBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="TIME" FontSize="9" FontWeight="Bold" Foreground="{StaticResource HubMutedBrush}"/>
                        <TextBlock x:Name="ElapsedText" Text="00:00" FontSize="18" FontWeight="Bold" Foreground="{StaticResource HubTextBrush}"/>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                <TextBlock Text="DIFFICULTY"
                           VerticalAlignment="Center"
                           Margin="0,0,10,8"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="{StaticResource HubMutedBrush}"/>
                <ComboBox x:Name="DifficultyComboBox"
                          Width="140"
                          Height="35"
                          SelectedIndex="0"
                          Margin="0,0,10,8"
                          Background="{StaticResource HubCardBrush}"
                          Foreground="{StaticResource HubTextBrush}"
                          BorderBrush="{StaticResource HubBorderBrush}"
                          SelectionChanged="DifficultyComboBox_SelectionChanged">
                    <ComboBoxItem Content="Easy"/>
                    <ComboBoxItem Content="Medium"/>
                    <ComboBoxItem Content="Hard"/>
                </ComboBox>
                <Button Content="NEW GAME"
                        Click="NewGameButton_Click"
                        Height="35"
                        MinWidth="110"
                        Margin="0,0,10,8"
                        Style="{StaticResource HubButtonPrimaryStyle}"/>
                <TextBlock x:Name="BestRecordText"
                           Text="Best: --:-- · Fewest: --"
                           VerticalAlignment="Center"
                           Margin="0,0,10,8"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource HubMutedBrush}"/>
            </WrapPanel>

            <ScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="10"
                        CornerRadius="14"
                        Background="{StaticResource HubCardBrush}"
                        BorderBrush="{StaticResource HubBorderBrush}"
                        BorderThickness="1">
                    <UniformGrid x:Name="BoardGrid"/>
                </Border>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText"
                           Text="Reveal a card to start."
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource HubAccentBrush}"/>
                <Button Grid.Column="1"
                        Content="BACK TO LIBRARY"
                        Click="BackButton_Click"
                        Height="38"
                        MinWidth="150"
                        Margin="8,0,0,0"
                        Style="{StaticResource HubButtonStyle}"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
