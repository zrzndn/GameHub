<UserControl x:Class="WindowsITToolkit.Games.TwentyFortyEight.TwentyFortyEightGameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="2048"
                           FontSize="26"
                           FontWeight="ExtraBold"
                           Foreground="{StaticResource HubTextBrush}"/>
                <TextBlock Text="SLIDE, MERGE, AND REACH THE TARGET"
                           Margin="0,4,0,0"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource HubMutedBrush}"/>
            </StackPanel>
            <WrapPanel Grid.Column="1"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right">
                <Border Padding="14,8"
                        Margin="0,0,8,0"
                        CornerRadius="10"
                        Background="{StaticResource HubCardBrush}"
                        BorderBrush="{StaticResource HubBorderBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="SCORE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource HubMutedBrush}"/>
                        <TextBlock x:Name="ScoreText" Text="0" FontSize="20" FontWeight="Bold" Foreground="{StaticResource HubAccentBrush}"/>
                    </StackPanel>
                </Border>
                <Border Padding="14,8"
                        CornerRadius="10"
                        Background="{StaticResource HubCardBrush}"
                        BorderBrush="{StaticResource HubBorderBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="BEST" FontSize="9" FontWeight="Bold" Foreground="{StaticResource HubMutedBrush}"/>
                        <TextBlock x:Name="BestScoreText" Text="0" FontSize="20" FontWeight="Bold" Foreground="{StaticResource HubSecondaryAccentBrush}"/>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="8">
                <Border Padding="12"
                        CornerRadius="16"
                        Background="{StaticResource HubCardBrush}"
                        BorderBrush="{StaticResource HubBorderBrush}"
                        BorderThickness="1"
                        Effect="{StaticResource HubCardShadow}">
                    <Viewbox MaxWidth="520"
                             MaxHeight="520"
                             Stretch="Uniform">
                        <UniformGrid x:Name="BoardGrid"
                                     Width="500"
                                     Height="500"
                                     IsHitTestVisible="False"
                                     Rows="4"
                                     Columns="4">
                            <Button Style="{StaticResource HubButtonStyle}" Margin="5" FontSize="30" FontWeight="ExtraBold"/>
                            <Button Style="{StaticResource HubButtonStyle}" Margin="5" FontSize="30" FontWeight="ExtraBold"/>
                            <Button Style="{StaticResource HubButtonStyle}" Margin="5" FontSize="30" FontWeight="ExtraBold"/>
                            <Button Style="{StaticResource HubButtonStyle}" Margin="5" FontSize="30" FontWeight="ExtraBold"/>
                            <Button Style="{StaticResource HubButtonStyle}" Margin="5" FontSize="30" FontWeight="ExtraBold"/>
                            <Button Style="{StaticResource HubButtonStyle}" Margin="5" FontSize="30" FontWeight="ExtraBold"/>
                            <Button Style="{StaticResource HubButtonStyle}" Margin="5" FontSize="30" FontWeight="ExtraBold"/>
                            <Button Style="{StaticResource HubButtonStyle}" Margin="5" FontSize="30" FontWeight="ExtraBold"/>
                            <Button Style="{StaticResource HubButtonStyle}" Margin="5" FontSize="30" FontWeight="ExtraBold"/>
                            <Button Style="{StaticResource HubButtonStyle}" Margin="5" FontSize="30" FontWeight="ExtraBold"/>
                            <Button Style="{StaticResource HubButtonStyle}" Margin="5" FontSize="30" FontWeight="ExtraBold"/>
                            <Button Style="{StaticResource HubButtonStyle}" Margin="5" FontSize="30" FontWeight="ExtraBold"/>
                            <Button Style="{StaticResource HubButtonStyle}" Margin="5" FontSize="30" FontWeight="ExtraBold"/>
                            <Button Style="{StaticResource HubButtonStyle}" Margin="5" FontSize="30" FontWeight="ExtraBold"/>
                            <Button Style="{StaticResource HubButtonStyle}" Margin="5" FontSize="30" FontWeight="ExtraBold"/>
                            <Button Style="{StaticResource HubButtonStyle}" Margin="5" FontSize="30" FontWeight="ExtraBold"/>
                        </UniformGrid>
                    </Viewbox>
                </Border>
                <TextBlock Text="Move with the arrow keys or WASD."
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0"
                           FontSize="12"
                           Foreground="{StaticResource HubMutedBrush}"/>
                <TextBlock x:Name="StatusText"
                           Text="Combine matching tiles to reach 2048."
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,5,0,0"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource HubAccentBrush}"/>
                <WrapPanel HorizontalAlignment="Center"
                           Margin="0,12,0,0">
                    <Button Content="NEW GAME"
                            Click="NewGameButton_Click"
                            Height="42"
                            MinWidth="120"
                            Margin="0,0,8,8"
                            Style="{StaticResource HubButtonPrimaryStyle}"/>
                    <Button x:Name="ContinueButton"
                            Content="CONTINUE"
                            Click="ContinueButton_Click"
                            Height="42"
                            MinWidth="120"
                            Margin="0,0,8,8"
                            Visibility="Collapsed"
                            Style="{StaticResource HubButtonSecondaryStyle}"/>
                    <Button Content="BACK TO LIBRARY"
                            Click="BackButton_Click"
                            Height="42"
                            MinWidth="150"
                            Margin="0,0,0,8"
                            Style="{StaticResource HubButtonStyle}"/>
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
