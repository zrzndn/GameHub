<UserControl x:Class="WindowsITToolkit.Games.Snake.SnakeGameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WindowsITToolkit"
             Focusable="True"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="SNAKE"
                           FontSize="26"
                           FontWeight="ExtraBold"
                           Foreground="{StaticResource HubTextBrush}"/>
                <TextBlock Text="COLLECT FOOD • GROW LONGER • BEAT YOUR BEST"
                           Margin="0,4,0,0"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource HubMutedBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Border Background="{StaticResource HubCardBrush}"
                        BorderBrush="{StaticResource HubBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14,8"
                        Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="SCORE"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource HubMutedBrush}"/>
                        <TextBlock x:Name="ScoreText"
                                   Text="0"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource HubAccentBrush}"/>
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource HubCardBrush}"
                        BorderBrush="{StaticResource HubBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14,8">
                    <StackPanel>
                        <TextBlock Text="BEST"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource HubMutedBrush}"/>
                        <TextBlock x:Name="HighScoreText"
                                   Text="0"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource HubSuccessBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    MaxWidth="640"
                    MaxHeight="640"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="8"
                    Background="#0B1424"
                    BorderBrush="#1E3A50"
                    BorderThickness="1"
                    CornerRadius="12">
                <Viewbox Stretch="Uniform">
                    <local:SnakeBoard x:Name="GameBoard"
                                      Width="500"
                                      Height="500"
                                      Focusable="False"/>
                </Viewbox>
            </Border>

            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        Margin="22,0,0,0">
                <TextBlock Text="YOUR RUN"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{StaticResource HubSecondaryAccentBrush}"/>
                <TextBlock Text="Choose a pace"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource HubTextBrush}"
                           Margin="0,14,0,7"/>
                <ComboBox x:Name="DifficultyComboBox"
                          Height="38"
                          SelectedIndex="1"
                          Background="{StaticResource HubCardBrush}"
                          Foreground="{StaticResource HubTextBrush}"
                          BorderBrush="{StaticResource HubBorderBrush}"
                          SelectionChanged="DifficultyComboBox_SelectionChanged">
                    <ComboBoxItem Content="Easy"/>
                    <ComboBoxItem Content="Normal"/>
                    <ComboBoxItem Content="Hard"/>
                </ComboBox>

                <TextBlock Text="CONTROLS"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{StaticResource HubSecondaryAccentBrush}"
                           Margin="0,24,0,9"/>
                <TextBlock Text="Move  Arrow keys / WASD&#x0a;Pause  Space / Escape"
                           FontSize="12"
                           Foreground="{StaticResource HubMutedBrush}"
                           LineHeight="21"
                           TextWrapping="Wrap"/>

                <Button x:Name="PauseButton"
                        Content="PAUSE"
                        Click="PauseButton_Click"
                        Height="40"
                        Margin="0,24,0,0"
                        Style="{StaticResource HubButtonSecondaryStyle}"/>
                <Button Content="RESTART"
                        Click="RestartButton_Click"
                        Height="40"
                        Margin="0,9,0,0"
                        Style="{StaticResource HubButtonStyle}"/>
                <Button Content="BACK TO LIBRARY"
                        Click="BackButton_Click"
                        Height="40"
                        Margin="0,9,0,0"
                        Style="{StaticResource HubButtonStyle}"/>
            </StackPanel>

            <Grid x:Name="OverlayPanel"
                  Grid.ColumnSpan="2"
                  Visibility="Collapsed"
                  Background="#990F172A">
                <Border Width="350"
                        Padding="26"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{StaticResource HubCardBrush}"
                        BorderBrush="{StaticResource HubAccentBrush}"
                        BorderThickness="1"
                        CornerRadius="16">
                    <StackPanel>
                        <TextBlock x:Name="OverlayTitleText"
                                   Text="PAUSED"
                                   FontSize="28"
                                   FontWeight="ExtraBold"
                                   Foreground="{StaticResource HubAccentBrush}"
                                   TextAlignment="Center"/>
                        <TextBlock x:Name="OverlayMessageText"
                                   Text="Your run is waiting."
                                   FontSize="13"
                                   Foreground="{StaticResource HubMutedBrush}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,18"/>
                        <Button x:Name="OverlayPrimaryButton"
                                Content="RESUME"
                                Click="OverlayPrimaryButton_Click"
                                Height="42"
                                Style="{StaticResource HubButtonPrimaryStyle}"/>
                        <Button Content="RESTART"
                                Click="RestartButton_Click"
                                Height="40"
                                Margin="0,9,0,0"
                                Style="{StaticResource HubButtonStyle}"/>
                        <Button Content="BACK TO LIBRARY"
                                Click="BackButton_Click"
                                Height="40"
                                Margin="0,9,0,0"
                                Style="{StaticResource HubButtonStyle}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="2"
                   x:Name="StatusText"
                   Text="Ready"
                   FontSize="11"
                   Foreground="{StaticResource HubMutedBrush}"
                   HorizontalAlignment="Center"
                   Margin="0,12,0,0"
                   TextWrapping="Wrap"/>
    </Grid>
</UserControl>
