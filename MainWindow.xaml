<Window x:Class="WindowsITToolkit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WindowsITToolkit"
        Title="Windows Arcade Hub"
        Width="1280"
        Height="900"
        MinWidth="800"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource HubBackgroundBrush}"
        Foreground="{StaticResource HubTextBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76"/>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource HubCardBrush}"
                BorderBrush="{StaticResource HubBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Width="38"
                            Height="38"
                            CornerRadius="11"
                            Background="{StaticResource HubHoverBrush}"
                            BorderBrush="{StaticResource HubBorderBrush}"
                            BorderThickness="1">
                        <TextBlock Text="WH"
                                   Foreground="{StaticResource HubAccentBrush}"
                                   FontSize="13"
                                   FontWeight="ExtraBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center"
                                Margin="12,0,0,0">
                        <TextBlock Text="WINDOWS ARCADE HUB"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource HubTextBrush}"/>
                        <TextBlock Text="YOUR DESKTOP, YOUR PLAYGROUND"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource HubMutedBrush}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1"
                        Padding="14,8"
                        CornerRadius="16"
                        Background="{StaticResource HubCardBrush}"
                        BorderBrush="{StaticResource HubBorderBrush}"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7"
                                 Height="7"
                                 Fill="{StaticResource HubSecondaryAccentBrush}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0"/>
                        <TextBlock Text="ARCADE"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource HubMutedBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="{StaticResource HubBackgroundBrush}"
                BorderBrush="{StaticResource HubBorderBrush}"
                BorderThickness="0,0,0,1">
            <UniformGrid x:Name="NavigationPanel"
                         Columns="6"
                         Margin="28,5">
                <Button x:Name="LibraryNavigationButton" Content="LIBRARY" Tag="library" Click="NavigationButton_Click" Style="{StaticResource HubButtonStyle}" Margin="3"/>
                <Button x:Name="FavoritesNavigationButton" Content="FAVORITES" Tag="favorites" Click="NavigationButton_Click" Style="{StaticResource HubButtonStyle}" Margin="3"/>
                <Button x:Name="RecentNavigationButton" Content="RECENT" Tag="recent" Click="NavigationButton_Click" Style="{StaticResource HubButtonStyle}" Margin="3"/>
                <Button x:Name="StatisticsNavigationButton" Content="STATISTICS" Tag="statistics" Click="NavigationButton_Click" Style="{StaticResource HubButtonStyle}" Margin="3"/>
                <Button x:Name="SettingsNavigationButton" Content="SETTINGS" Tag="settings" Click="NavigationButton_Click" Style="{StaticResource HubButtonStyle}" Margin="3"/>
                <Button x:Name="AboutNavigationButton" Content="ABOUT" Tag="about" Click="NavigationButton_Click" Style="{StaticResource HubButtonStyle}" Margin="3"/>
            </UniformGrid>
        </Border>

        <ContentControl x:Name="ContentHost"
                        Grid.Row="2"
                        Margin="28,24,28,20"/>
    </Grid>
</Window>
